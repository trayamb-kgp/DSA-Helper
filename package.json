{
  "name": "dsa-helper",
  "version": "0.1.0",
  "description": "From a DSA problem page to a YouTube search or a ready-to-send ChatGPT review, in one keystroke.",
  "license": "PolyForm-Strict-1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "check:build": "node tools/check-build.mjs",
    "test:e2e": "playwright test --project=e2e",
    "test:e2e:live": "playwright test --project=live",
    "test:e2e:report": "playwright show-report e2e/output/report",
    "verify": "npm run typecheck && npm run test && npm run build && npm run check:build"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.1.28",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^28.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
